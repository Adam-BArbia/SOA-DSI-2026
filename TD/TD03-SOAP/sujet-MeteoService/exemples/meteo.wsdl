  xmlns:tns="http://www.mymeteo.com/webservices/meteo"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ns1="http://www.mymeteo.com/meteo"
  targetNamespace="http://www.mymeteo.com/webservices/meteo" name="MeteoService">
