  <portType name="MeteoService"><operation name="releveMeteo"><input message="tns:releveMeteo"/><output message="tns:releveMeteoResponse"/></operation></portType>
  <binding name="MeteoServicePortBinding" type="tns:MeteoService"><soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/><operation name="releveMeteo"><soap:operation soapAction=""/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation></binding>
