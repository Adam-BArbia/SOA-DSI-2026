    <xs:complexType name="lieu"><xs:sequence><xs:element name="ville" type="xs:string"/></xs:sequence></xs:complexType>
    <xs:complexType name="releve"><xs:sequence><xs:element name="temperature" type="ns1:temperature"/><xs:element name="lieu" type="ns1:lieu"/></xs:sequence></xs:complexType>
